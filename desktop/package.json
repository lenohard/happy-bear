{
  "name": "polarbear-desktop",
  "version": "0.1.5",
  "private": true,
  "description": "PolarBear read-only audiobook player",
  "main": "./out/main/index.js",
  "bin": {
    "polarbear": "scripts/polarbear-cli.mjs"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc -b tsconfig.main.json && tsc -b tsconfig.preload.json && tsc -b tsconfig.renderer.json",
    "dist": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --publish never",
    "release": "npm run build && electron-builder --publish always"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^2.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "homepage": "https://github.com/lenohard/happy-bear",
  "author": {
    "name": "lenohard",
    "email": "lenohard@users.noreply.github.com"
  }
}